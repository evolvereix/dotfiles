{
  // [Updates]
  "update.mode": "manual",
  // [Editor]
  "editor.tabSize": 2,
  "editor.fontSize": 13.5,
  "editor.lineHeight": 1.6,
  "editor.wordWrap": "off",
  "editor.lineNumbers": "interval",
