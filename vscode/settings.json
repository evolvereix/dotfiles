  "window.systemColorTheme": "auto",
  // [Files]
  "outline.collapseItems": "alwaysCollapse",
  "files.eol": "\n",
  "files.simpleDialog.enable": true,
  "files.associations": {
    ".env.*": "dotenv",
    "*.cjson": "jsonc",
    "*.wxs": "javascript",
    "*.wxss": "css",
    ".eslintrc": "jsonc",
    ".code-workspace": "jsonc",
    "*.sgmodule": "properties",
    "*.conf": "ini",
    "*.dconf": "ini"
  },
  "files.autoSaveWhenNoErrors": true,
  // [Search]
  "search.quickOpen.history.filterSortOrder": "recency",
  "search.searchEditor.singleClickBehaviour": "peekDefinition",
  "search.followSymlinks": false,
  "search.exclude": {
    "**/*.snap": true,
    "**/*.svg": true,
    "**/.git": true,
    "**/.github": false,
    "**/.nuxt": true,
    "**/.output": true,
    "**/.pnpm": true,
    "**/.vscode": true,
    "**/.yarn": true,
    "**/assets": true,
    "**/bower_components": true,
    "**/dist/**": true,
    "**/logs": true,
    "**/node_modules": true,
    "**/out/**": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "**/public": true,
    "**/temp": true,
    "**/yarn.lock": true,
    "**/CHANGELOG*": true,
    "**/LICENSE*": true
  },
  // [Debug]
  "debug.console.fontSize": 13,
  "debug.onTaskErrors": "debugAnyway",
  "debug.toolBarLocation": "commandCenter",
  "debug.breakpointsView.presentation": "tree",
  // [SCM & Diff]
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.untrackedChanges": "separate",
  "git.timeline.showUncommitted": true,
  "git.blame.ignoreWhitespace": true,
  "git.addAICoAuthor": "off",
  "scm.workingSets.enabled": true,
  "scm.diffDecorationsGutterWidth": 2,
  "scm.repositories.explorer": true,
  "scm.repositories.selectionMode": "single",
  "diffEditor.diffAlgorithm": "advanced",
  "diffEditor.maxComputationTime": 0,
  "diffEditor.experimental.showMoves": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.hideUnchangedRegions.contextLineCount": 16,
  "diffEditor.ignoreTrimWhitespace": false,
  // [Terminal]
  "terminal.integrated.stickyScroll.enabled": true,
  "terminal.integrated.tabs.allowAgentCliTitle": true,
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontWeight": "300",
  "terminal.integrated.fontFamily": "SFMono Nerd Font",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.autoReplies": {
    "[Oh My Zsh] Would you like to check for updates? [Y/n]": "Y\r"
  },
  "terminal.integrated.env.osx": {
    "FIG_NEW_SESSION": "1"
  },
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.enableImages": true,
  "terminal.integrated.enableKittyKeyboardProtocol": true,
  // [Format]
  "css.lint.hexColorLength": "ignore",
  "css.format.spaceAroundSelectorSeparator": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "[json][jsonc][less][javascript][typescript][typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[markdown][plaintext][juliamarkdown]": {
    "editor.wordWrap": "on",
    "editor.wrappingStrategy": "advanced"
  },
  "html.format.contentUnformatted": "pre,code,textarea",
  "prettier.semi": false,
  "prettier.tabWidth": 2,
  "prettier.singleQuote": true,
  "prettier.proseWrap": "never",
  "prettier.printWidth": 100,
  "prettier.trailingComma": "none",
  "eslint.quiet": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "jsonc",
    "yaml",
    "toml"
  ],
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  // [Languages]
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "markdown.preview.doubleClickToSwitchToEditor": false,
  "markdown.preview.markEditorSelection": false,
  "js/ts.suggest.paths": false,
  // [Telemetry]
  "redhat.telemetry.enabled": false,
  // [Extensions]
