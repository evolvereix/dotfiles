  // [Copilot]
  "chat.stickyScroll.enabled": true,
  "interactiveWindow.promptToSaveOnClose": true,
  "sessions.changes.openSingleFileDiff": true,
  "sessions.layout.autoCollapseSessionsSidebar": true,
  "sessions.layout.singlePaneDetailPanel": true,
  "chat.agentHost.allowSignedOutWhenUsable": true,
  "chat.assistedPermissions.enabled": true,
  "chat.tools.compressOutput.enabled": true,
  "chat.useCustomizationsInParentRepositories": true,
  "chat.useNestedAgentsMdFiles": true,
  "chat.experimental.incrementalRendering.enabled": true,
  "chat.experimental.incrementalRendering.buffering": "paragraph",
  "github.copilot.chat.skillTool.enabled": true,
  "chat.agent.sandbox.enabled": "on",
  "chat.agent.sandbox.allowNetwork": true,
  "chat.tips.enabled": false,
  "github.copilot.chat.exploreAgent.enabled": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.nextEditSuggestions.extendedRange": true,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "less": false
  },

  // [AI]
  "jsts-chat-features.skills.enabled": true,

  // --- Extension configs ---
  "emmet.showSuggestionsAsSnippets": true,
  "svgPreview.autoOpen": false,
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "errorLens.excludeBySource": ["cSpell", "Grammarly", "eslint"],
  "cSpell.language": "en,en-US",
  "cSpell.allowCompoundWords": true,
  "gitlens.menus": false,
  "gitlens.views.searchAndCompare.files.layout": "tree",
  "gitlens.views.worktrees.files.layout": "list",
  "gitlens.views.commitDetails.files.layout": "tree",
  "gitlens.codeLens.enabled": false,
  "gitlens.codeLens.authors.enabled": false,
  "gitlens.codeLens.recentChange.enabled": false,
  "gitlens.graph.minimap.enabled": false,
  "gitlens.graph.dimMergeCommits": true,
  "gitlens.graph.onlyFollowFirstParent": true,
  "gitlens.remotes": [
    {
      "domain": "code.byted.org",
      "type": "GitLab"
    }
  ],
  "better-comments.tags": [
    // 已知 bug，需要修复
    // FIXME: discount > 1 时会计算错误
    { "tag": "FIXME", "color": "#FF6E67", "bold": true },
    // 已知缺陷，必须修复。通常和 issue 挂钩
    // BUG(#4567): useEffect 在某些情况下未触发，待修复
    { "tag": "BUG", "color": "#FF8F70", "bold": true },
    // 危险/潜在问题：提醒特别小心
    // XXX: 此逻辑在并发下可能出现竞态条件
    { "tag": "XXX", "color": "#FF9E6D", "bold": true },
    // 待办事项，需要补充或改进。中性提醒
    // TODO(alice, 2025-09-05): 支持更多支付方式
    { "tag": "TODO", "color": "#80C7FF", "bold": true },
    // 可以优化性能或结构
    // OPTIMIZE: 考虑用二分查找提升性能
    { "tag": "OPTIMIZE", "color": "#FFD56B", "italic": true },
    // 需要他人检查确认
    // REVIEW(bob): 请确认逻辑是否符合产品需求
    { "tag": "REVIEW", "color": "#6FCF97", "underline": true, "bold": true },
    // 重要说明或设计决策
    // NOTE: 此处强制使用 UTC，避免时区问题
    { "tag": "NOTE", "color": "#C3E88D", "italic": true },
    // 弃用：未来会移除
    // DEPRECATED: v1 API，已不推荐使用
    { "tag": "DEPRECATED", "color": "#B0B0C0", "strikethrough": true },
    // 临时方案：不优雅/权宜实现
    // HACK: 临时用 setTimeout 模拟异步，待 API 替换
    { "tag": "HACK", "color": "#C792EA", "italic": true },
    // 如果是暂时禁用功能，使用 feature flag / 配置开关 控制
    // Feature flag 控制某功能是否启用
    // const ENABLE_LEGACY_CHECK = false;
    // if (ENABLE_LEGACY_CHECK) {} else if () {}
    // 必要时用 DISABLED 标记说明原因、责任人、恢复条件。
    // DISABLED(bob, 2025-09-05): 暂时关闭老逻辑，等待安全团队评审 TASK-1234
    { "tag": "DISABLED", "color": "#A77DC2", "strikethrough": true, "bold": true }
  ]
}